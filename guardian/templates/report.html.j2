<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Supply Chain Guardian</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
{% raw %}
<style>
:root{
  --bg:#f5f7fb; --surface:#ffffff; --surface-2:#f9fafc; --ink:#0f172a; --ink-2:#334155; --muted:#64748b; --faint:#94a3b8;
  --line:#e6e9f0; --line-2:#eef1f6;
  --brand:#4338ca; --brand-2:#6366f1; --brand-soft:#eef0ff; --teal:#0d9488; --teal-soft:#e6f6f4;
  --crit:#dc2626; --crit-soft:#fdecec; --high:#ea580c; --high-soft:#fff1e7; --med:#ca8a04; --med-soft:#fdf6e3;
  --low:#2563eb; --low-soft:#e9f0ff; --info:#64748b; --info-soft:#f1f5f9;
  --ev:#15803d; --ev-soft:#effaf3; --ev-line:#bfe6cd; --ai:#7c3aed; --ai-soft:#f6f1ff; --ai-line:#dccbfb;
  --shadow:0 1px 2px rgba(15,23,42,.04),0 4px 16px rgba(15,23,42,.05);
  --radius:14px; --sans:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; --mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
}
*{box-sizing:border-box} html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:14.5px/1.55 var(--sans);-webkit-font-smoothing:antialiased;font-feature-settings:"cv11","ss01"}
a{color:var(--brand);text-decoration:none} a:hover{text-decoration:underline}
.mono,code{font-family:var(--mono);font-size:12.5px}
code{background:var(--line-2);padding:1px 6px;border-radius:5px;color:var(--ink-2);word-break:break-all}
h1,h2,h3,h4{margin:0;letter-spacing:-.015em;color:var(--ink)}
.muted{color:var(--muted)} .faint{color:var(--faint)} .small{font-size:12.5px} .xs{font-size:11.5px}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}

/* ---------- top bar + tabs ---------- */
.topbar{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
.topbar-inner{max-width:1320px;margin:0 auto;padding:14px 24px 0;display:flex;flex-direction:column;gap:12px}
.brandrow{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.logo{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--brand),var(--teal));display:grid;place-items:center;color:#fff;flex:none;box-shadow:0 4px 12px rgba(67,56,202,.25)}
.brandtxt b{display:block;font-size:15.5px;font-weight:700;letter-spacing:-.01em}
.brandtxt span{font-size:12px;color:var(--muted)}
.meta-chips{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}
.mchip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:4px 11px;font-size:12px;color:var(--ink-2);background:var(--surface-2);white-space:nowrap}
.mchip i{width:7px;height:7px;border-radius:50%;background:var(--teal);display:inline-block}
.mchip.ai i{background:var(--ai)}
.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;margin:0 -6px}
.tabs::-webkit-scrollbar{display:none}
.tab{appearance:none;border:0;background:none;font:inherit;font-size:13.5px;font-weight:500;color:var(--muted);padding:10px 12px 12px;cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;display:flex;align-items:center;gap:7px}
.tab:hover{color:var(--ink)}
.tab.active{color:var(--brand);border-bottom-color:var(--brand);font-weight:600}
.tab .count{font-size:11px;background:var(--line-2);color:var(--muted);border-radius:999px;padding:0 7px;font-weight:600}
.tab.active .count{background:var(--brand-soft);color:var(--brand)}

main{max-width:1320px;margin:0 auto;padding:28px 24px 80px}
section.view{display:none;animation:fade .25s ease} section.view.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.vhead{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap}
.vhead h2{font-size:22px;font-weight:700} .vhead p{margin:4px 0 0;color:var(--muted);max-width:760px}

/* ---------- primitives ---------- */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.pad{padding:20px}
.grid{display:grid;gap:16px}
.g3{grid-template-columns:repeat(3,minmax(0,1fr))} .g2{grid-template-columns:repeat(2,minmax(0,1fr))}
.g-side{grid-template-columns:minmax(0,1.55fr) minmax(0,1fr)}
.badge{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:700;padding:2px 9px;border-radius:999px;white-space:nowrap}
.b-Critical{background:var(--crit-soft);color:var(--crit)} .b-High{background:var(--high-soft);color:var(--high)}
.b-Medium{background:var(--med-soft);color:#a16207} .b-Low{background:var(--low-soft);color:var(--low)} .b-Info{background:var(--info-soft);color:var(--info)}
.dot{width:7px;height:7px;border-radius:50%;display:inline-block;background:currentColor}
.chip{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:500;padding:2px 8px;border-radius:6px;background:var(--line-2);color:var(--ink-2);white-space:nowrap}
.chip.new{background:var(--crit);color:#fff;font-weight:700;letter-spacing:.03em}
.chip.aich{background:var(--ai-soft);color:var(--ai);font-weight:600}
.chip.scope-runtime{background:#fef3c7;color:#92400e} .chip.scope-dev{background:var(--line-2);color:var(--muted)}
.chip.scope-build{background:#e0f2fe;color:#075985} .chip.scope-ci{background:#ede9fe;color:#5b21b6}
.btn{appearance:none;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:inherit;font-size:13px;font-weight:600;padding:8px 14px;border-radius:9px;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
.btn:hover{border-color:var(--brand-2);color:var(--brand)}
.btn.primary{background:var(--brand);color:#fff;border-color:var(--brand)} .btn.primary:hover{background:var(--brand-2);color:#fff}
input.search,select.sel{font:inherit;font-size:13px;border:1px solid var(--line);border-radius:9px;padding:8px 11px;background:var(--surface);color:var(--ink);outline:none}
input.search:focus,select.sel:focus{border-color:var(--brand-2);box-shadow:0 0 0 3px var(--brand-soft)}
.empty{padding:40px;text-align:center;color:var(--muted)}

/* ---------- overview ---------- */
.hero{padding:26px 28px;background:linear-gradient(120deg,#ffffff 0%,#f4f3ff 55%,#eafaf7 100%);border:1px solid var(--line);border-radius:18px;margin-bottom:18px;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:center}
.hero h1{font-size:28px;font-weight:800;letter-spacing:-.025em}
.hero .tagline{font-size:13px;font-weight:600;color:var(--brand);letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
.hero p{margin:6px 0 0;color:var(--ink-2);max-width:620px}
.hero-stats{display:flex;gap:28px}
.hero-stats div b{display:block;font-size:26px;font-weight:800;letter-spacing:-.02em}
.hero-stats div span{font-size:12px;color:var(--muted)}
.cp{padding:20px 22px;position:relative;overflow:hidden}
.cp .q{display:flex;align-items:center;gap:9px;font-weight:700;font-size:14px;margin-bottom:14px}
.cp .qi{width:30px;height:30px;border-radius:9px;display:grid;place-items:center}
.cp .big{font-size:38px;font-weight:800;letter-spacing:-.03em;line-height:1}
.cp .bigsub{color:var(--muted);font-size:13px;margin:4px 0 14px}
.kv{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;border-top:1px solid var(--line-2);padding-top:12px}
.kv b{display:block;font-size:17px;font-weight:700} .kv span{font-size:11.5px;color:var(--muted)}
.changes li{display:flex;gap:8px;align-items:flex-start;padding:5px 0;font-size:13px;border-bottom:1px dashed var(--line-2)}
.changes li:last-child{border-bottom:0}
.changes .k{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--crit);background:var(--crit-soft);padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:2px}
ul.clean{list-style:none;margin:0;padding:0}
.stack{display:flex;height:10px;border-radius:6px;overflow:hidden;background:var(--line-2);margin:6px 0 12px}
.stack div{height:100%}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--ink-2)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.sw{width:9px;height:9px;border-radius:3px;display:inline-block}

.pipeline{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0;margin:18px 0}
.step{padding:18px 18px 16px;position:relative;border-right:1px solid var(--line-2)}
.step:last-child{border-right:0}
.step .n{width:26px;height:26px;border-radius:8px;background:var(--brand-soft);color:var(--brand);font-weight:800;font-size:12px;display:grid;place-items:center;margin-bottom:10px}
.step h4{font-size:14px;font-weight:700} .step p{margin:3px 0 10px;font-size:12.5px;color:var(--muted)}
.step .m{font-size:20px;font-weight:800;letter-spacing:-.02em} .step .ml{font-size:11.5px;color:var(--muted)}
.step.ai .n{background:var(--ai-soft);color:var(--ai)}

.aibox{background:var(--ai-soft);border:1px solid var(--ai-line);border-radius:var(--radius);padding:20px 22px}
.aibox .lbl{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ai);margin-bottom:8px}
.aibox p{margin:0 0 10px;color:var(--ink-2)}
.fixfirst li{display:flex;gap:12px;align-items:center;padding:11px 4px;border-bottom:1px solid var(--line-2);cursor:pointer;border-radius:8px}
.fixfirst li:hover{background:var(--surface-2)}
.fixfirst li:last-child{border-bottom:0}
.rank{width:24px;height:24px;border-radius:7px;background:var(--line-2);font-size:12px;font-weight:700;display:grid;place-items:center;flex:none;color:var(--ink-2)}
.fixfirst .t{font-size:13.5px;font-weight:600;line-height:1.35} .fixfirst .s{font-size:12px;color:var(--muted)}
.catbars .row{display:grid;grid-template-columns:150px 1fr 40px;gap:10px;align-items:center;font-size:13px;padding:4px 0}
.catbars .tr{height:8px;background:var(--line-2);border-radius:5px;overflow:hidden} .catbars .tr div{height:100%;background:var(--brand-2);border-radius:5px}

/* ---------- findings master/detail ---------- */
.md{display:grid;grid-template-columns:400px minmax(0,1fr);gap:16px;align-items:start}
.filters{display:flex;flex-wrap:wrap;gap:8px;padding:14px;border-bottom:1px solid var(--line)}
.filters input.search{flex:1 1 100%}
.filters select.sel{flex:1 1 30%}
.toggles{display:flex;gap:6px;flex-wrap:wrap;width:100%}
.tg{appearance:none;font:inherit;font-size:12px;font-weight:600;border:1px solid var(--line);background:var(--surface);color:var(--ink-2);border-radius:999px;padding:4px 11px;cursor:pointer}
.tg.on{background:var(--brand);border-color:var(--brand);color:#fff}
.flist{max-height:calc(100vh - 290px);overflow:auto}
.fitem{padding:12px 14px;border-bottom:1px solid var(--line-2);cursor:pointer;border-left:3px solid transparent}
.fitem:hover{background:var(--surface-2)}
.fitem.sel{background:var(--brand-soft);border-left-color:var(--brand)}
.fitem .t{font-size:13.5px;font-weight:600;line-height:1.35;margin:5px 0 3px;color:var(--ink)}
.fitem .c{font-family:var(--mono);font-size:11.5px;color:var(--muted)}
.fitem .top{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.lcount{padding:10px 14px;font-size:12px;color:var(--muted);border-bottom:1px solid var(--line-2);background:var(--surface-2)}
.detail{position:sticky;top:120px}
.dhead{padding:22px 24px 18px;border-bottom:1px solid var(--line)}
.dhead h3{font-size:19px;font-weight:700;line-height:1.3;margin:8px 0 6px}
.dbody{padding:20px 24px;display:grid;gap:18px}
.dl{display:grid;grid-template-columns:150px 1fr;gap:8px 16px;font-size:13.5px}
.dl dt{color:var(--muted);font-weight:500} .dl dd{margin:0;min-width:0}
.pathc{display:flex;flex-wrap:wrap;align-items:center;gap:4px;margin:2px 0 6px}
.pnode{font-family:var(--mono);font-size:11.5px;padding:3px 8px;border-radius:6px;background:var(--line-2);color:var(--ink-2)}
.pnode.root{background:var(--brand-soft);color:var(--brand);font-weight:600}
.pnode.leaf{background:var(--crit-soft);color:var(--crit);font-weight:600}
.parr{color:var(--faint);font-size:12px}
.sec-t{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px}
.evbox{background:var(--ev-soft);border:1px solid var(--ev-line);border-radius:12px;padding:14px 16px}
.evbox .sec-t{color:var(--ev)}
.evbox li{font-size:13px;padding:6px 0;border-bottom:1px solid var(--ev-line);color:var(--ink-2)} .evbox li:last-child{border-bottom:0}
.evbox .src{font-weight:700;color:var(--ev);margin-right:4px}
.aiblk{background:var(--ai-soft);border:1px solid var(--ai-line);border-radius:12px;padding:14px 16px}
.aiblk .sec-t{color:var(--ai)}
.aiq{display:grid;grid-template-columns:150px 1fr;gap:6px 14px;font-size:13px}
.aiq dt{font-weight:600;color:var(--ai)} .aiq dd{margin:0;color:var(--ink-2)}
.guard{margin-top:12px;padding-top:10px;border-top:1px dashed var(--ai-line);font-size:12px;color:var(--ink-2);display:flex;gap:14px;flex-wrap:wrap}
.guard b{color:var(--ev)}
.score{display:flex;align-items:center;gap:16px}
.gauge{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;flex:none}
.gauge span{width:50px;height:50px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font-weight:800;font-size:17px}
.rat{display:grid;gap:4px;font-size:12.5px;flex:1}
.rat div{display:flex;gap:8px;align-items:baseline}
.rat .d{font-family:var(--mono);font-weight:600;min-width:44px;text-align:right}
.rat .plus{color:var(--crit)} .rat .minus{color:var(--ev)} .rat .base{color:var(--ink-2)}

/* ---------- tables ---------- */
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{text-align:left;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);padding:10px 12px;border-bottom:1px solid var(--line);background:var(--surface-2);position:sticky;top:0}
.tbl td{padding:10px 12px;border-bottom:1px solid var(--line-2);vertical-align:top}
.tbl tr.click{cursor:pointer} .tbl tr.click:hover td{background:var(--surface-2)}
.tblwrap{overflow:auto;max-height:640px;border-radius:0 0 var(--radius) var(--radius)}
.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:14px 16px;border-bottom:1px solid var(--line)}

/* ---------- graph ---------- */
.gwrap{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px}
#net{height:calc(100vh - 260px);min-height:520px;border-radius:0 0 var(--radius) var(--radius);background:radial-gradient(circle at 1px 1px,#e7eaf2 1px,transparent 0) 0 0/22px 22px}
.gside{padding:18px;max-height:calc(100vh - 200px);overflow:auto}

/* ---------- report document ---------- */
.doc{max-width:900px;margin:0 auto;padding:48px 56px}
.doc h1{font-size:28px;font-weight:800;letter-spacing:-.02em}
.doc h2{font-size:17px;font-weight:700;margin:30px 0 10px;padding-bottom:6px;border-bottom:1px solid var(--line)}
.doc p,.doc li{color:var(--ink-2)}
.doc .dmeta{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0;padding:14px 16px;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;font-size:12.5px}
.doc .dmeta b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:700}
.doc .tbl td,.doc .tbl th{padding:8px 9px}
.sign{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:14px}
.sign div{border:1px dashed var(--line);border-radius:10px;padding:16px;min-height:80px;font-size:12.5px;color:var(--muted)}

/* ---------- approach ---------- */
.arch{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:10px}
.abox{border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--surface)}
.abox h4{font-size:13.5px;margin-bottom:6px} .abox li{font-size:12.5px;color:var(--ink-2)}
.abox.ai{border-color:var(--ai-line);background:var(--ai-soft)}
.abox.ev{border-color:var(--ev-line);background:var(--ev-soft)}
.arrow{color:var(--faint);font-size:22px;text-align:center}
.formula{font-family:var(--mono);font-size:12.5px;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:14px;line-height:1.8}

@media (max-width:1050px){.g3,.g-side,.g2,.md,.gwrap,.pipeline,.arch{grid-template-columns:1fr}.detail{position:static}.step{border-right:0;border-bottom:1px solid var(--line-2)}.arrow{transform:rotate(90deg)}}
@media (max-width:640px){main{padding:18px 16px 60px}.topbar-inner{padding:12px 16px 0}.meta-chips{margin-left:0}.doc{padding:24px 18px}.dl,.aiq{grid-template-columns:1fr}.hero-stats{gap:18px}.doc .dmeta{grid-template-columns:1fr}}
@media print{
  .topbar,.noprint{display:none!important} body{background:#fff} main{padding:0;max-width:none}
  section.view{display:none!important} section#v-report{display:block!important}
  .card{box-shadow:none;border:0} .doc{padding:0}
}
</style>
{% endraw %}
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <div class="brandrow">
      <div class="logo"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.6-3.4 8.4-8 9-4.6-.6-8-4.4-8-9V6l8-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg></div>
      <div class="brandtxt"><b>Supply Chain Guardian</b><span>Know what you build. Trust what you ship.</span></div>
      <div class="meta-chips" id="metaChips"></div>
    </div>
    <nav class="tabs" id="tabs">
      <button class="tab" data-tab="overview">Overview</button>
      <button class="tab" data-tab="findings">Findings <span class="count" id="cntF"></span></button>
      <button class="tab" data-tab="changes">What Changed <span class="count" id="cntC"></span></button>
      <button class="tab" data-tab="graph">Dependency Graph</button>
      <button class="tab" data-tab="container">Container &amp; CI/CD</button>
      <button class="tab" data-tab="sbom">SBOM &amp; Inventory</button>
      <button class="tab" data-tab="report">Final Report</button>
      <button class="tab" data-tab="approach">Our Approach</button>
    </nav>
  </div>
</header>

<main>
  <section class="view" id="v-overview"></section>
  <section class="view" id="v-findings"></section>
  <section class="view" id="v-changes"></section>
  <section class="view" id="v-graph"></section>
  <section class="view" id="v-container"></section>
  <section class="view" id="v-sbom"></section>
  <section class="view" id="v-report"></section>
  <section class="view" id="v-approach"></section>
</main>

<script id="report-data" type="application/json">{{ report|tojson }}</script>
<script id="graph-data" type="application/json">{{ graph|tojson }}</script>
<script>{{ vis_js|safe }}</script>
{% raw %}
<script>
(() => {
const R = JSON.parse(document.getElementById('report-data').textContent);
const G = JSON.parse(document.getElementById('graph-data').textContent);
const F = R.findings, CP = R.checkpoint, W = CP.what_is_in_the_app, CH = CP.what_changed || {}, RK = CP.what_looks_risky;
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const LV = ['Critical','High','Medium','Low','Info'];
const LVC = {Critical:'var(--crit)',High:'var(--high)',Medium:'var(--med)',Low:'var(--low)',Info:'var(--info)'};
const CAT = {'malicious-package':'Malicious package','vulnerability':'Known vulnerability','suspicious-change':'Suspicious change','container':'Container','ci-cd':'CI/CD','manifest-hygiene':'Manifest hygiene'};
const aiOn = R.ai.mode === 'llm';
const badge = f => `<span class="badge b-${f.risk_level}"><i class="dot"></i>${f.risk_level} · ${f.risk_score}</span>`;
const scope = s => `<span class="chip scope-${esc(s)}">${esc(s)}</span>`;
const pathHTML = p => `<div class="pathc">${p.map((n,i)=>`${i?'<span class="parr">›</span>':''}<span class="pnode ${i===0?'root':i===p.length-1?'leaf':''}">${esc(n)}</span>`).join('')}</div>`;
const fmt = n => Number(n).toLocaleString();
const newCount = F.filter(f=>f.changed).length;
const aiFindings = F.filter(f=>f.ai);

/* ---------- header ---------- */
$('#metaChips').innerHTML = `
  <span class="mchip"><i></i>${esc(R.target.name)}@${esc(R.target.version)}</span>
  <span class="mchip ai"><i></i>${aiOn ? 'AI · ' + esc(R.ai.model) : 'AI · deterministic fallback'}</span>
  <span class="mchip">${esc(new Date(R.generated_at).toLocaleString())}</span>`;
$('#cntF').textContent = F.length; $('#cntC').textContent = newCount;

/* ---------- router ---------- */
const rendered = {};
const views = {overview, findings, changes, graph, container, sbom, report, approach};
function go(tab, arg){
  if (!views[tab]) tab = 'overview';
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
  document.querySelectorAll('section.view').forEach(v => v.classList.toggle('active', v.id === 'v-' + tab));
  if (!rendered[tab]) { views[tab]($('#v-' + tab)); rendered[tab] = true; }
  if (tab === 'findings' && arg) selectFinding(arg);
  if (location.hash.slice(1).split('/')[0] !== tab) history.replaceState(null, '', '#' + tab);
  window.scrollTo({top:0});
}
document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => go(t.dataset.tab)));
window.addEventListener('hashchange', () => { const [t,a] = location.hash.slice(1).split('/'); go(t, a && decodeURIComponent(a)); });
const openFinding = id => go('findings', id);

/* ---------- OVERVIEW ---------- */
