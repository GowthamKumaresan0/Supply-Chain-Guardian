      <div class="bigsub">packages resolved from <code>package-lock.json</code> v${W.lockfile_version}</div>
      <div class="kv">
        <div><b>${W.direct}</b><span>direct</span></div><div><b>${fmt(W.transitive)}</b><span>transitive</span></div><div><b>${W.max_depth}</b><span>max depth</span></div>
        <div><b>${W.runtime}</b><span>in prod image</span></div><div><b>${fmt(W.dev_only)}</b><span>dev / test</span></div><div><b>${W.with_install_scripts}</b><span>install scripts</span></div>
