  const nf = F.filter(f=>f.changed);
  const groups = [['Added packages',CH.added,'var(--crit)'],['Integrity changed',CH.integrity_changed,'var(--crit)'],['Source changed',CH.source_changed,'var(--high)'],
                  ['Scripts changed',CH.scripts_changed,'var(--high)'],['New base images',CH.new_images,'var(--high)'],['New CI workflows',CH.new_workflows,'var(--high)'],
                  ['Version changes',CH.version_changed,'var(--low)'],['Removed packages',CH.removed,'var(--info)']];
  const integ = F.filter(f=>f.id.startsWith('DIFF-INT-'));
  el.innerHTML = `
  <div class="vhead"><div><h2>What changed</h2><p>The current tree is compared position by position with a trusted baseline: lockfile entries, hashes, download sources, lifecycle scripts, Dockerfile and CI workflows.</p></div></div>
  <div class="grid g3" style="margin-bottom:16px">${groups.filter(g=>(g[1]||[]).length).map(([t,l,c])=>`
    <div class="card pad"><div style="display:flex;justify-content:space-between;align-items:center"><span class="eyebrow">${t}</span><b style="font-size:20px;color:${c}">${l.length}</b></div>
    <ul class="clean changes" style="margin-top:8px">${l.map(x=>`<li><span class="mono" style="font-size:12px">${esc(x)}</span></li>`).join('')}</ul></div>`).join('')}</div>
  ${integ.map(f=>{const d=f.evidence[0].data;return `<div class="card pad" style="margin-bottom:16px"><div class="eyebrow" style="color:var(--crit)">Tamper evidence · ${esc(f.component)}</div>
    <div class="grid g2" style="margin-top:10px">
      <div><div class="small muted">Baseline (trusted)</div><div class="mono small">${esc(d.baseline_resolved)}</div><code>${esc(d.baseline_integrity)}</code></div>
      <div><div class="small muted">Current</div><div class="mono small" style="color:var(--crit)">${esc(d.current_resolved)}</div><code style="color:var(--crit)">${esc(d.current_integrity)}</code></div>
    </div><div class="small" style="margin-top:8px">${esc(f.evidence[0].detail)}</div></div>`}).join('')}
  <div class="card"><div class="toolbar"><b>${nf.length} findings introduced by this change</b><span class="muted small">click a row for full evidence</span></div>
  <div class="tblwrap"><table class="tbl"><thead><tr><th>Risk</th><th>Finding</th><th>Component</th><th>Scope</th><th>Evidence</th></tr></thead><tbody>
  ${nf.map(f=>`<tr class="click" data-id="${esc(f.id)}"><td>${badge(f)}</td><td>${esc(f.title)}</td><td class="mono small">${esc(f.component)}</td><td>${scope(f.scope)}</td><td class="small muted">${esc([...new Set(f.evidence.map(e=>e.source))].join(', '))}</td></tr>`).join('')}
  </tbody></table></div></div>`;
  el.querySelectorAll('tr.click').forEach(r => r.onclick = () => openFinding(r.dataset.id));
}

/* ---------- GRAPH ---------- */
function graph(el){
  const labels = G.nodes.map(n=>n.label).sort();
  el.innerHTML = `
  <div class="vhead"><div><h2>Dependency graph</h2><p>The app's direct dependencies, plus the shortest path to every high-risk or newly introduced component. Click a node to see why it is there; search to trace a package back to the app.</p></div></div>
  <div class="gwrap">
    <div class="card">
      <div class="toolbar">
        <input class="search" id="gq" list="glabels" placeholder="Find a package, e.g. flatmap-stream" style="flex:1;min-width:220px">
        <datalist id="glabels">${labels.map(l=>`<option value="${esc(l)}">`).join('')}</datalist>
        <button class="btn" id="gfit">Fit view</button>
        <div class="legend"><span><i class="sw" style="background:var(--brand)"></i>app</span><span><i class="sw" style="background:#475569"></i>direct</span><span><i class="sw" style="background:#cbd5e1"></i>transitive</span><span><i class="sw" style="background:var(--crit)"></i>flagged</span><span><i class="sw" style="border:1.5px dashed #94a3b8;background:#fff"></i>dev-only</span></div>
      </div>
      <div id="net"></div>
    </div>
    <div class="card gside" id="gside"><div class="eyebrow">Node details</div><p class="muted small">Click a node in the graph. Flagged nodes are red; their findings appear here.</p>
      <div class="eyebrow" style="margin-top:18px">In this view</div>
      <div class="kv" style="border:0;padding:0;margin-top:8px"><div><b>${G.nodes.length}</b><span>nodes</span></div><div><b>${G.edges.length}</b><span>edges</span></div><div><b>${G.nodes.filter(n=>n.flagged).length}</b><span>flagged</span></div></div></div>
  </div>`;
  if (typeof vis === 'undefined') { $('#net').innerHTML = '<div class="empty">Graph library unavailable.</div>'; return; }
  const css = getComputedStyle(document.documentElement), v = n => css.getPropertyValue(n).trim();
  const nodes = new vis.DataSet(G.nodes.map(n => ({
    id: n.id === '' ? '__root__' : n.id, label: n.label, raw: n,
    shape: n.root ? 'box' : 'dot', size: n.root ? 22 : n.flagged ? 11 : n.direct ? 10 : 6,
    margin: n.root ? 10 : undefined,
    color: { background: n.root ? v('--brand') : n.flagged ? v('--crit') : n.direct ? '#475569' : '#cbd5e1',
             border: n.dev ? '#94a3b8' : (n.flagged ? v('--crit') : n.root ? v('--brand') : '#ffffff'),
             highlight: { background: v('--brand-2'), border: v('--brand') } },
    borderWidth: n.dev ? 1.5 : 2, shapeProperties: { borderDashes: n.dev ? [3,3] : false },
    font: { face: 'Inter', size: n.root ? 14 : (n.flagged || n.direct) ? 12 : 9, color: n.root ? '#fff' : (n.flagged ? v('--crit') : '#334155'), strokeWidth: n.root ? 0 : 3, strokeColor: '#fff' }
  })));
  const edges = new vis.DataSet(G.edges.map((e,i) => ({ id:i, from: e.from===''?'__root__':e.from, to: e.to, arrows:{to:{enabled:true,scaleFactor:.45}}, color:{color:'#d5dbe5',highlight:v('--brand')}, width: 1 })));
  const net = new vis.Network($('#net'), {nodes, edges}, {
    physics: { solver:'forceAtlas2Based', forceAtlas2Based:{gravitationalConstant:-45, springLength:80}, stabilization:{iterations:300} },
    interaction: { hover:true, tooltipDelay:120 }, layout: { improvedLayout: true } });
  net.once('stabilizationIterationsDone', () => net.setOptions({ physics: false }));
  const parentsOf = id => G.edges.filter(e => e.to === id).map(e => e.from);
  function pathTo(id){ const p=[id]; let cur=id, guard=0; while(cur!=='' && guard++<40){ const ps=parentsOf(cur); if(!ps.length) break; cur=ps.includes('')?'':ps[0]; p.unshift(cur);} return p; }
  function showNode(id){
    const raw = id==='__root__' ? '' : id; const n = G.nodes.find(x=>x.id===raw); if (!n) return;
    const inv = (R.inventory||[]).find(c=>c.lock_path===raw);
    const fs = F.filter(f=>f.component===n.label);
    const p = pathTo(raw); const ids = p.map(x=>x===''?'__root__':x);
    net.selectNodes(ids); net.focus(ids[ids.length-1], {scale:1.1, animation:{duration:500}});
    $('#gside').innerHTML = `<div class="eyebrow">Node details</div><h3 style="font-size:16px;margin:8px 0 4px" class="mono">${esc(n.label)}</h3>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">${n.root?'<span class="chip">application</span>':n.direct?'<span class="chip">direct</span>':'<span class="chip">transitive</span>'}${n.root?'':scope(n.dev?'dev':'runtime')}${inv&&inv.install_script?'<span class="chip" style="color:var(--crit)">install script</span>':''}</div>
      ${inv?`<dl class="dl" style="grid-template-columns:90px 1fr;font-size:12.5px"><dt>Source</dt><dd class="mono">${esc(inv.source)}</dd><dt>Depth</dt><dd>${inv.depth}</dd><dt>Required by</dt><dd>${inv.parents} package(s)</dd></dl>`:''}
      <div class="eyebrow" style="margin:14px 0 6px">Path from the app</div>${pathHTML(p.map(x=>G.nodes.find(y=>y.id===x)?.label||x))}
      <div class="eyebrow" style="margin:14px 0 6px">Findings (${fs.length})</div>
      ${fs.length?`<ul class="clean">${fs.slice(0,12).map(f=>`<li style="padding:7px 0;border-bottom:1px solid var(--line-2);cursor:pointer" data-id="${esc(f.id)}">${badge(f)} <span class="small">${esc(f.title)}</span></li>`).join('')}</ul>`:'<div class="small muted">No findings for this component.</div>'}`;
    $('#gside').querySelectorAll('li[data-id]').forEach(li => li.onclick = () => openFinding(li.dataset.id));
  }
  net.on('click', e => e.nodes.length && showNode(e.nodes[0]));
  $('#gq').addEventListener('change', e => { const n = G.nodes.find(x=>x.label===e.target.value); if (n) showNode(n.id===''?'__root__':n.id); });
  $('#gfit').onclick = () => net.fit({animation:{duration:400}});
}

/* ---------- CONTAINER & CI ---------- */
function container(el){
  const img = F.filter(f=>f.id.startsWith('IMAGE-'));
  const df = F.filter(f=>f.category==='container' && !f.id.startsWith('IMAGE-'));
  const ci = F.filter(f=>f.category==='ci-cd');
  const byWf = {}; ci.forEach(f => (byWf[f.component] = byWf[f.component] || []).push(f));
  const row = f => `<tr class="click" data-id="${esc(f.id)}"><td>${badge(f)}</td><td>${f.changed?'<span class="chip new">NEW</span> ':''}${esc(f.title)}<div class="xs muted mono">${esc(f.location)}</div></td></tr>`;
  el.innerHTML = `
  <div class="vhead"><div><h2>Container &amp; CI/CD</h2><p>The build pipeline is part of the supply chain. We statically check the Dockerfile and GitHub Actions, and scan the real base image with Trivy, with no Docker daemon needed.</p></div></div>
  ${img.map(f=>{const d=f.evidence[0].data||{}, c=d.counts||{}, os=d.os||{}; return `
  <div class="card pad" style="margin-bottom:16px">
    <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center">
      <div><div class="eyebrow">Base image scan · Trivy</div><h3 class="mono" style="font-size:18px;margin-top:4px">${esc(f.component)}</h3>
      <div class="small muted">${esc(os.Family||'')} ${esc(os.Name||'')}${os.EOSL?' · <b style="color:var(--crit)">OS end-of-support</b>':''}</div></div>
      <div class="hero-stats">${['CRITICAL','HIGH','MEDIUM','LOW'].map(s=>`<div><b style="color:${LVC[s[0]+s.slice(1).toLowerCase()]}">${c[s]||0}</b><span>${s.toLowerCase()}</span></div>`).join('')}</div>
    </div>
    ${(d.top||[]).length?`<div class="tblwrap" style="margin-top:14px;max-height:320px;border:1px solid var(--line);border-radius:10px"><table class="tbl"><thead><tr><th>Advisory</th><th>Package</th><th>Installed</th><th>Fixed</th><th>Layer</th></tr></thead><tbody>
      ${d.top.map(t=>`<tr><td><span class="badge b-${t.severity==='CRITICAL'?'Critical':'High'}">${esc(t.id)}</span></td><td class="mono small">${esc(t.pkg)}</td><td class="mono small">${esc(t.installed)}</td><td class="mono small">${esc(t.fixed||'-')}</td><td class="small muted">${esc(t.target)}</td></tr>`).join('')}
    </tbody></table></div>`:''}
  </div>`}).join('')}
  <div class="grid g2">
    <div class="card"><div class="toolbar"><b>Dockerfile</b><span class="chip">${df.length} findings</span></div>
      <table class="tbl"><tbody>${df.map(row).join('')}</tbody></table></div>
    <div class="card"><div class="toolbar"><b>GitHub Actions workflows</b><span class="chip">${ci.length} findings</span></div>
      ${Object.entries(byWf).map(([wf,l])=>`<div style="padding:10px 12px 0" class="eyebrow mono">${esc(wf.split('/').pop())}</div><table class="tbl"><tbody>${l.map(row).join('')}</tbody></table>`).join('')}</div>
  </div>`;
  el.querySelectorAll('tr.click').forEach(r => r.onclick = () => openFinding(r.dataset.id));
}

/* ---------- SBOM ---------- */
function sbom(el){
  const inv = R.inventory || []; const byLabel = {}; F.forEach(f => byLabel[f.component] = (byLabel[f.component]||0)+1);
  const syft = R.sbom.syft_crosscheck || {};
  el.innerHTML = `
  <div class="vhead"><div><h2>SBOM &amp; inventory</h2><p>Every installed package with its scope, depth and download source, exported as a CycloneDX 1.5 SBOM including the dependency relationships.</p></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap"><a class="btn" href="sbom.cdx.json" download>⬇ SBOM (CycloneDX)</a>${R.baseline?'<a class="btn" href="sbom.baseline.cdx.json" download>⬇ Baseline SBOM</a>':''}<a class="btn" href="guardian_report.json" download>⬇ Report JSON</a></div></div>
  <div class="grid g3" style="margin-bottom:16px;grid-template-columns:repeat(4,minmax(0,1fr))">
    ${[['Components',fmt(W.total_components)],['Unique name@version',fmt(W.unique_name_versions)],['Production packages',W.runtime_unique_name_versions||W.runtime],['Syft cross-check',syft.npm_components?`${syft.npm_components} <span class="small" style="color:var(--ev)">✓ matches</span>`:'not run']]
      .map(([k,v])=>`<div class="card pad"><div class="eyebrow">${k}</div><div style="font-size:24px;font-weight:800;margin-top:6px">${v}</div></div>`).join('')}
  </div>
  <div class="card"><div class="toolbar"><input class="search" id="sq" placeholder="Filter packages…" style="flex:1;min-width:200px">
    <select class="sel" id="ss"><option value="">All scopes</option><option>runtime</option><option>dev</option></select>
    <select class="sel" id="sd"><option value="">Direct + transitive</option><option value="1">Direct only</option></select>
    <label class="small"><input type="checkbox" id="sf"> with findings</label><span class="small muted" id="scount"></span></div>
  <div class="tblwrap"><table class="tbl"><thead><tr><th>Package</th><th>Version</th><th>Type</th><th>Scope</th><th>Depth</th><th>Source</th><th>Findings</th></tr></thead><tbody id="sbody"></tbody></table></div></div>`;
  const draw = () => { const q=$('#sq').value.toLowerCase(), s=$('#ss').value, d=$('#sd').value, wf=$('#sf').checked;
    const rows = inv.filter(c => (!q||c.label.toLowerCase().includes(q)) && (!s||c.scope===s) && (!d||c.direct) && (!wf||byLabel[c.label]));
    $('#scount').textContent = `${rows.length} packages`;
    $('#sbody').innerHTML = rows.slice(0,300).map(c=>`<tr><td class="mono small"><b>${esc(c.name)}</b></td><td class="mono small">${esc(c.version)}</td><td>${c.direct?'<span class="chip">direct</span>':'<span class="small muted">transitive</span>'}</td><td>${scope(c.scope)}</td><td>${c.depth}</td>
      <td class="mono xs ${c.source!=='registry.npmjs.org'?'':'muted'}" style="${c.source!=='registry.npmjs.org'?'color:var(--crit)':''}">${esc(c.source)}</td><td>${byLabel[c.label]?`<span class="badge b-High">${byLabel[c.label]}</span>`:''}</td></tr>`).join('')
      + (rows.length>300?`<tr><td colspan="7" class="small muted">Showing 300 of ${rows.length}. Refine the filter.</td></tr>`:''); };
  ['#sq','#ss','#sd','#sf'].forEach(s => $(s).addEventListener('input', draw)); draw();
}

/* ---------- FINAL REPORT ---------- */
function report(el){
  const L = RK.by_risk_level, top = F.slice(0,15);
  const gen = new Date(R.generated_at);
  el.innerHTML = `
  <div class="noprint" style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:14px">
    <button class="btn" id="dlj">⬇ Download JSON</button><button class="btn primary" onclick="window.print()">Print / Save as PDF</button></div>
  <article class="card doc">
    <div class="eyebrow" style="color:var(--brand)">Guardian Report · Day 1 · Detection & Evidence</div>
    <h1 style="margin-top:6px">Supply-chain assessment of ${esc(R.target.name)}@${esc(R.target.version)}</h1>
    <div class="dmeta">
      <div><b>Prepared by</b>${esc(R.tool.team)}</div><div><b>Date</b>${gen.toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'})}</div><div><b>Tool</b>Supply Chain Guardian v${esc(R.tool.version)}</div>
      <div><b>Target</b>${esc(R.target.upstream)}</div><div><b>Compared with</b>${R.baseline?'trusted baseline copy':'no baseline'}</div><div><b>AI model</b>${aiOn?esc(R.ai.model):'not used (fallback)'}</div>
    </div>

    <h2>1. Executive summary</h2>
    <p>${R.ai.executive_summary?esc(R.ai.executive_summary):`The application contains ${W.total_components} components. ${newCount} findings were introduced compared with the baseline, and ${L.Critical} findings are rated critical.`}</p>
    ${R.ai.executive_summary?'<p class="xs muted">Summary drafted by AI from verified evidence; figures below are tool-generated.</p>':''}

    <h2>2. Key figures</h2>
    <table class="tbl"><tbody>
      <tr><td>Components (direct / transitive)</td><td><b>${fmt(W.total_components)}</b> (${W.direct} / ${fmt(W.transitive)})</td></tr>
      <tr><td>Shipped in production image</td><td><b>${W.runtime}</b> package instances</td></tr>
      <tr><td>Known advisories (OSV.dev)</td><td><b>${R.vulnerability_scan.advisories}</b> on ${R.vulnerability_scan.vulnerable_packages} package versions</td></tr>
      <tr><td>Findings by initial risk</td><td>${LV.map(l=>`<span class="badge b-${l}" style="margin-right:4px">${l} ${L[l]}</span>`).join('')}</td></tr>
      <tr><td>Introduced since baseline</td><td><b style="color:var(--crit)">${newCount}</b> findings</td></tr>
      <tr><td>Container base image(s)</td><td class="mono small">${[...new Set(W.container_images)].join(', ')}</td></tr>
      <tr><td>CI workflows inspected</td><td class="mono small">${W.ci_workflows.map(w=>w.split('/').pop()).join(', ')}</td></tr>
    </tbody></table>

    <h2>3. What changed</h2>
    <ul>${[...(CH.added||[]).map(x=>`New package <code>${esc(x)}</code>`),...(CH.integrity_changed||[]).map(x=>`Integrity hash changed for <code>${esc(x)}</code> (same version)`),
      ...(CH.source_changed||[]).map(x=>`Download source changed: <code>${esc(x)}</code>`),...(CH.scripts_changed||[]).map(x=>`Changed: ${esc(x)}`),
      ...(CH.new_images||[]).map(x=>`New base image <code>${esc(x)}</code>`),...(CH.new_workflows||[]).map(x=>`New workflow <code>${esc(x)}</code>`)].map(x=>`<li>${x}</li>`).join('')}</ul>

    <h2>4. Prioritised findings</h2>
    <table class="tbl"><thead><tr><th>#</th><th>Risk</th><th>Finding</th><th>Component</th><th>Scope</th><th>Evidence</th></tr></thead><tbody>
      ${top.map((f,i)=>`<tr><td>${i+1}</td><td>${badge(f)}</td><td>${f.changed?'<span class="chip new">NEW</span> ':''}${esc(f.title)}</td><td class="mono xs">${esc(f.component)}</td><td>${esc(f.scope)}</td><td class="xs">${esc([...new Set(f.evidence.map(e=>e.source))].join(', '))}</td></tr>`).join('')}
    </tbody></table>
    ${R.ai.prioritisation_rationale?`<p style="margin-top:10px"><b>Prioritisation rationale (AI):</b> ${esc(R.ai.prioritisation_rationale)}</p>`:''}

    <h2>5. Analysed findings: evidence and reasoning</h2>
    ${aiFindings.map((f,i)=>`<div style="margin:0 0 16px;padding:14px 16px;border:1px solid var(--line);border-radius:10px;break-inside:avoid">
      <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap"><b>${i+1}. ${esc(f.title)}</b>${badge(f)}</div>
      <div class="xs muted mono" style="margin:3px 0 8px">${esc(f.component)} · ${esc(f.location)}</div>
      ${f.dependency_paths.length?pathHTML(f.dependency_paths[0]):''}
      <p class="small" style="margin:6px 0"><b style="color:var(--ev)">Evidence:</b> ${f.evidence.map(e=>`[${esc(e.source)}] ${esc(e.detail)}`).join(' ')}</p>
      <p class="small" style="margin:6px 0"><b style="color:var(--ai)">Reasoning:</b> ${esc(f.ai.risk_reasoning||f.ai.why_it_matters)}</p>
      <p class="small" style="margin:6px 0"><b>Recommended next step:</b> ${esc(f.ai.suggested_next_step)}</p></div>`).join('')}

    <h2>6. Method</h2>
    <p>Components were resolved from the npm lockfile with Node's module-resolution rules and exported as CycloneDX 1.5 (cross-checked with Syft). Vulnerabilities and known malware come from OSV.dev; the container base image was scanned with Trivy. Non-CVE risks were detected by typosquat analysis (edit distance and npm download statistics), lockfile integrity and source checks, a baseline diff, and Dockerfile and GitHub Actions rules. Initial risk is a deterministic score; its rationale is recorded per finding.</p>

    <h2>7. Responsible AI statement</h2>
    <p>AI (${aiOn?esc(R.ai.model):'not used in this run'}) was used only to explain and justify the top ${R.ai.sent_findings} findings and to draft the summary. It received evidence only, with no source code or secrets. Advisory IDs not present in the evidence are removed automatically, and claimed evidence sources are checked against the finding. AI output never changes risk scores, files or dependencies. All remediation requires human approval.</p>

    <h2>8. Limitations and residual risk</h2>
    <ul><li>Reachability (whether vulnerable code is actually called) is not yet analysed, so scores may overstate some transitive vulnerabilities.</li>
      <li>Only the npm ecosystem is covered in this version. Floating images (<code>:latest</code>) are flagged but not scanned.</li>
      <li>Typosquat detection relies on a curated reference list and public download statistics.</li></ul>

    <h2>9. Review and approval (Day 2)</h2>
    <div class="sign"><div>Security reviewer<br><br>Name / date / decision</div><div>Application owner<br><br>Name / date / decision</div></div>
  </article>`;
  $('#dlj').onclick = () => { const b = new Blob([JSON.stringify(R,null,2)],{type:'application/json'}); const a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download='guardian_report.json'; a.click(); };
}

/* ---------- APPROACH ---------- */
function approach(el){
  el.innerHTML = `
  <div class="vhead"><div><h2>Our approach</h2><p>Agents with one job each. Deterministic tools establish the facts; the LLM explains them. Nothing is installed, executed or changed without a human.</p></div></div>
  <div class="card pad" style="margin-bottom:16px">
    <div class="arch">
      <div class="abox"><h4>Inputs</h4><ul class="clean"><li>package.json · package-lock.json</li><li>Dockerfile</li><li>.github/workflows/*</li><li>Trusted baseline copy</li></ul></div>
      <div class="arrow">→</div>
      <div class="abox ev"><h4>Deterministic agents (verified evidence)</h4><ul class="clean"><li>① Discovery: components and edges</li><li>② SBOM + graph: CycloneDX, paths</li><li>③ Vulnerabilities: OSV.dev, Trivy</li><li>④ Anomalies: typosquat, scripts, integrity, diff, Docker/CI rules</li><li>Risk scorer: explainable 0–100</li></ul></div>
      <div class="arrow">→</div>
      <div class="abox ai"><h4>AI explainer (inference)</h4><ul class="clean"><li>Top-N findings only, 1 cached call</li><li>Explain · justify risk · next step</li><li>Guardrails: ID + evidence check</li><li>Model fallback chain + template</li></ul></div>
    </div>
  </div>
  <div class="grid g2">
    <div class="card pad"><div class="eyebrow" style="margin-bottom:10px">Initial risk score</div>
      <div class="formula">base = CVSS × 10 &nbsp;or&nbsp; severity (85/65/40/20)<br>malicious package → floor 95<br>+10 ships in production image<br>−25 dev / test only<br>+10 CI step with secrets<br>+5 direct dependency<br>+10 new vs trusted baseline<br>+5 no fixed version<br>→ Critical ≥ 80 · High ≥ 60 · Medium ≥ 35 · Low ≥ 15</div></div>
    <div class="card pad"><div class="eyebrow" style="margin-bottom:10px">Evidence vs inference</div>
      <div class="evbox" style="margin-bottom:10px"><div class="sec-t">✔ Verified evidence</div><div class="small">Output of OSV.dev, Trivy, Syft, lockfile diff and rules. Reproducible, and the only input to scoring.</div></div>
      <div class="aiblk"><div class="sec-t">✦ AI inference</div><div class="small">Plain-English explanation, risk justification and next step. Must cite the evidence it used; invented IDs are removed.</div></div>
      <div class="eyebrow" style="margin:16px 0 8px">Safety</div>
      <ul class="small" style="margin:0;padding-left:18px;color:var(--ink-2)"><li>Target code is parsed only, never installed or run</li><li>Tamper scenario is local; reserved addresses only</li><li>API key stays in <code>.env</code>, never in reports</li><li>No auto-merge or deploy: human approval on Day 2</li></ul></div>
  </div>
  <div class="card pad" style="margin-top:16px"><div class="eyebrow" style="margin-bottom:10px">AI run audit trail</div>
    <div class="small">Mode <b>${esc(R.ai.mode)}</b> · model <b>${esc(R.ai.model)}</b> · findings sent <b>${R.ai.sent_findings}</b> · API calls ${R.ai.calls.api} · cache hits ${R.ai.calls.cache_hits}</div>
    <div style="margin-top:8px">${(R.ai.model_attempts||[]).map(a=>`<span class="chip" style="margin:2px">${esc(a)}</span>`).join('')}</div></div>`;
}

const [t0,a0] = location.hash.slice(1).split('/'); go(t0 || 'overview', a0 && decodeURIComponent(a0));
})();
</script>
{% endraw %}
</body>
</html>
