/* ---------- FINDINGS ---------- */
let fState = {q:'', lvl:'', cat:'', scope:'', ai: aiFindings.length>0, nw:false}, selId = null;
function findings(el){
  el.innerHTML = `
  <div class="vhead"><div><h2>Findings</h2><p>Each finding pairs <b style="color:var(--ev)">verified evidence</b> from scanners, diffs and rules with <b style="color:var(--ai)">AI reasoning</b> that explains it. Select one to see its dependency path, score breakdown and explanation.</p></div></div>
  <div class="md">
    <div class="card" style="overflow:hidden">
      <div class="filters">
        <input class="search" id="fq" placeholder="Search package, advisory ID, title…">
        <select class="sel" id="fl"><option value="">All levels</option>${LV.map(l=>`<option>${l}</option>`).join('')}</select>
        <select class="sel" id="fc"><option value="">All categories</option>${Object.keys(RK.by_category).map(c=>`<option value="${c}">${CAT[c]||c}</option>`).join('')}</select>
        <select class="sel" id="fs"><option value="">All scopes</option>${['runtime','dev','build','ci'].map(s=>`<option>${s}</option>`).join('')}</select>
        <div class="toggles"><button class="tg" id="tgAi">✦ AI-analysed</button><button class="tg" id="tgNew">New vs baseline</button></div>
      </div>
      <div class="lcount" id="lcount"></div>
      <div class="flist" id="flist"></div>
    </div>
    <div class="card detail" id="fdetail"><div class="empty">Select a finding</div></div>
  </div>`;
  const upd = () => { fState.q=$('#fq').value.toLowerCase(); fState.lvl=$('#fl').value; fState.cat=$('#fc').value; fState.scope=$('#fs').value; renderList(); };
  ['#fq','#fl','#fc','#fs'].forEach(s => $(s).addEventListener('input', upd));
  $('#tgAi').onclick = () => { fState.ai=!fState.ai; renderList(); };
  $('#tgNew').onclick = () => { fState.nw=!fState.nw; renderList(); };
  renderList();
  if (!selId) selectFinding((fState.ai ? aiFindings[0] : F[0])?.id);
}
function filtered(){
  const s = fState;
  return F.filter(f => (!s.lvl||f.risk_level===s.lvl) && (!s.cat||f.category===s.cat) && (!s.scope||f.scope===s.scope)
    && (!s.ai||f.ai) && (!s.nw||f.changed)
    && (!s.q || (f.component+' '+f.title+' '+f.id+' '+f.vuln_ids.join(' ')).toLowerCase().includes(s.q)));
}
function renderList(){
  $('#tgAi').classList.toggle('on', fState.ai); $('#tgNew').classList.toggle('on', fState.nw);
  const rows = filtered();
  $('#lcount').textContent = `${rows.length} of ${F.length} findings`;
  $('#flist').innerHTML = rows.slice(0,400).map(f=>`<div class="fitem ${f.id===selId?'sel':''}" data-id="${esc(f.id)}">
    <div class="top">${badge(f)}${f.changed?'<span class="chip new">NEW</span>':''}${f.ai&&aiOn?'<span class="chip aich">✦ AI</span>':''}<span class="chip">${CAT[f.category]||f.category}</span></div>
    <div class="t">${esc(f.title)}</div><div class="c">${esc(f.component)}</div></div>`).join('') || '<div class="empty">No findings match these filters.</div>';
  $('#flist').querySelectorAll('.fitem').forEach(d => d.onclick = () => selectFinding(d.dataset.id));
}
function gauge(score){ const c = score>=80?'var(--crit)':score>=60?'var(--high)':score>=35?'var(--med)':'var(--low)';
  return `<div class="gauge" style="background:conic-gradient(${c} ${score*3.6}deg,var(--line-2) 0)"><span style="color:${c}">${score}</span></div>`; }
function rationale(list){ return list.map(r => { const m = r.match(/^([+-]\d+)\s+(.*)$/);
  if (m) return `<div><span class="d ${m[1][0]==='+'?'plus':'minus'}">${m[1]}</span><span>${esc(m[2])}</span></div>`;
  const b = r.match(/^base (\d+)\s+(.*)$/); if (b) return `<div><span class="d base">${b[1]}</span><span>base ${esc(b[2])}</span></div>`;
  return `<div><span class="d base">•</span><span>${esc(r)}</span></div>`; }).join(''); }
function selectFinding(id){
  const f = F.find(x=>x.id===id); if (!f || !$('#fdetail')) return;
  selId = id;
  document.querySelectorAll('.fitem').forEach(d => d.classList.toggle('sel', d.dataset.id===id));
  const a = f.ai, isLLM = a && a.source && a.source.startsWith('AI inference');
  $('#fdetail').innerHTML = `
    <div class="dhead">
      <div style="display:flex;gap:6px;flex-wrap:wrap">${badge(f)}${f.changed?'<span class="chip new">NEW vs baseline</span>':''}<span class="chip">${CAT[f.category]||f.category}</span>${scope(f.scope)}</div>
      <h3>${esc(f.title)}</h3>
      <div class="small muted mono">${esc(f.location)}${f.vuln_ids.length?' · '+esc(f.vuln_ids.slice(0,4).join(', ')):''}</div>
    </div>
    <div class="dbody">
      <dl class="dl">
        <dt>Component</dt><dd><code>${esc(f.component)}</code></dd>
        ${f.dependency_paths.length?`<dt>Dependency path${f.dependency_paths.length>1?'s':''}</dt><dd>${f.dependency_paths.slice(0,3).map(pathHTML).join('')}</dd>`:''}
        ${f.cvss!=null?`<dt>CVSS</dt><dd>${f.cvss}</dd>`:''}
        ${f.fixed_version?`<dt>Fixed in</dt><dd><code>${esc(f.fixed_version)}</code></dd>`:''}
        <dt>Confidence</dt><dd>${esc(f.confidence)} <span class="muted small">(evidence quality)</span></dd>
      </dl>
      <div><div class="sec-t" style="color:var(--ink-2)">Initial risk: how the score was built</div>
        <div class="score">${gauge(f.risk_score)}<div class="rat">${rationale(f.risk_rationale)}</div></div></div>
      <div class="evbox"><div class="sec-t">✔ Verified evidence</div>
        <ul class="clean">${f.evidence.map(e=>`<li><span class="src">${esc(e.source)}</span>${esc(e.detail)}</li>`).join('')}</ul>
        ${f.references.length?`<div class="xs" style="margin-top:8px">${f.references.map(u=>`<a href="${esc(u)}" target="_blank" rel="noopener">${esc(u.replace(/^https?:\/\//,'').slice(0,60))}</a>`).join(' · ')}</div>`:''}
      </div>
      ${a ? `<div class="aiblk"><div class="sec-t">✦ ${isLLM?'AI reasoning · '+esc(R.ai.model):'Explanation · deterministic template (LLM unavailable)'}${a.ai_confidence&&a.ai_confidence!=='n/a'?` · model confidence ${esc(a.ai_confidence)}`:''}</div>
        <dl class="aiq">
          <dt>What it means</dt><dd>${esc(a.explanation)}</dd>
          <dt>Why it matters here</dt><dd>${esc(a.why_it_matters)}</dd>
          ${a.risk_reasoning?`<dt>Risk reasoning</dt><dd>${esc(a.risk_reasoning)}</dd>`:''}
          <dt>Attack scenario</dt><dd>${esc(a.likely_attack_scenario)}</dd>
          <dt>Next step (Day 2)</dt><dd>${esc(a.suggested_next_step)} <span class="muted small">· requires human approval</span></dd>
          ${a.evidence_used&&a.evidence_used.length?`<dt>Evidence relied on</dt><dd>${a.evidence_used.map(s=>`<span class="chip">${esc(s)}</span>`).join(' ')}</dd>`:''}
        </dl>
        ${isLLM?`<div class="guard"><span>Guardrails:</span><span><b>✔</b> ${a.unverified_ids_removed.length} invented advisory IDs</span><span><b>✔</b> ${(a.evidence_claims_rejected||[]).length} unsupported evidence claims</span><span><b>✔</b> score untouched by AI</span></div>`:''}
      </div>` : `<div class="small muted">Not in the top ${R.ai.sent_findings} sent to the AI (free-tier budget). The deterministic evidence and score above are complete.</div>`}
    </div>`;
}

/* ---------- WHAT CHANGED ---------- */
